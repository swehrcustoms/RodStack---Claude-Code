# ============================================================
# RodStack V2 — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ---- Supabase ----
# From: supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-only. Never expose to client.

# ---- Anthropic (Claude AI) ----
# From: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ---- Stripe ----
# From: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...                      # Use sk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...                    # From: Stripe Dashboard → Webhooks

# Stripe Price IDs — create these in your Stripe Dashboard
# Dashboard → Products → Add Product → Add Price
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_BUILDER_MONTHLY_PRICE_ID=price_...
STRIPE_BUILDER_ANNUAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...

# ---- App ----
NEXT_PUBLIC_APP_URL=https://rodstack.app             # Your production URL
